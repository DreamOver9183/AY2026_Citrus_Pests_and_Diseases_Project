# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# Datasets and Large Archives
Datasets/
Datasets/*
*.rar
*.zip
*.tar
*.tar.gz
*.7z

# Dataset caches & PyTorch / YOLO caches
*.cache

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# AI Assistants & Agent directories
# 註：這裡用 `.claude/*` 而不是 `.claude/`。git 不會遞迴進被忽略的目錄，
#     寫成 `.claude/` 的話下面的 `!` 負向規則永遠不會生效。
.claude/*
# benchmark skill 要進版控（使用者要求：以後作為同 repo）
!.claude/skills/
.gemini/
.agents/
.cursor/
.windsurf/

# 訓練 log（大量進度條輸出，內容已摘要於 docs/）
*_Train_log.txt

# final_eval.py 每次執行自動產生，內含本機絕對路徑
Train Code/v9/Train_output/Phase4/v5r_local.yaml
Train Code/v10/Train_output/extracted/data_local.yaml

# 訓練輸出的解壓縮工作區：可由同目錄的 zip 完整重現，不進版控。
# 只保留 best.pt、超參數與評估數據（沿用 v9/v10 的慣例）。
Train Code/*/Train_output/extracted/**
!Train Code/*/Train_output/extracted/
!Train Code/*/Train_output/extracted/**/
!Train Code/*/Train_output/extracted/**/best.pt
!Train Code/*/Train_output/extracted/**/last.pt
!Train Code/*/Train_output/extracted/**/args.yaml
!Train Code/*/Train_output/extracted/**/*.json
!Train Code/*/Train_output/extracted/**/*.csv

# 為了與舊版比較而複製出來的評估子集（653 張影像，可由 _provenance.json 重建）
**/v55_subset/

# Benchmark：轉出來的模型每個數 MB 到數十 MB，且都可由對應的 last.pt 一行指令重現。
# 只保留 JSON 報告（小、且是實驗結果本身）。
Benchmark/Model/*.tflite
Benchmark/Model/other/**
!Benchmark/Model/other/*.json
Benchmark/export/out/
!Benchmark/Model/.gitkeep
